    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8771377909:AAEFG_egqXoFOM6Vc8cpnCRmFWbwqTNbgNQ/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
