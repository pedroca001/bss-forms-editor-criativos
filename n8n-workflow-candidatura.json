    {
      "parameters": {
        "jsCode": "function esc(v) {\n  if (v === null || v === undefined) return '';\n  return String(v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nreturn $input.all().map(item => {\n  const b = item.json;\n  const portfolio = b.portfolio && b.portfolio.trim() ? esc(b.portfolio) : 'Não informado';\n\n  const text = `🟢 <b>Nova candidatura — Editor de Criativos</b>\\n<i>${esc(b.data_envio)}</i>\\n\\n👤 <b>Nome:</b> ${esc(b.nome_completo)}\\n🪪 <b>CPF:</b> ${esc(b.cpf)}\\n🎂 <b>Idade:</b> ${esc(b.idade)}\\n📧 <b>E-mail:</b> ${esc(b.email)}\\n📱 <b>Celular:</b> ${esc(b.celular)}\\n💰 <b>Pretensão:</b> R$ ${esc(b.expectativa_remuneracao)}\\n🌐 <b>Inglês:</b> ${esc(b.nivel_ingles)}\\n🎬 <b>Experiência:</b> ${esc(b.nivel_experiencia)}\\n📹 <b>Tipos de vídeo:</b> ${esc(b.tipos_video)}\\n🛠 <b>Softwares:</b> ${esc(b.softwares_edicao)}\\n🤖 <b>IAs que usa:</b> ${esc(b.inteligencias_artificiais)}\\n📚 <b>Cursos:</b> ${esc(b.cursos_mentorias)}\\n🔗 <b>Portfólio:</b> ${portfolio}\\n📸 <b>Instagram:</b> ${esc(b.instagram)}\\n📣 <b>Como soube:</b> ${esc(b.origem_vaga)}`;\n\n  return {\n    json: {\n      ...b,\n      tg_text: text\n    }\n  };\n});"
      },
      "id": "node-build-text",
      "name": "Montar texto Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 240]
